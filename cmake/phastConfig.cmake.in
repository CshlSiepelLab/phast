@PACKAGE_INIT@

# On non-Apple builds phast_linalg links the imported BLAS::BLAS / LAPACK::LAPACK
# targets. Recreate them in the consumer's environment so the exported target does
# not depend on absolute library paths baked in at phast build time. On Apple the
# Accelerate framework is linked directly and needs no re-resolution.
if(NOT "@PHAST_BLAS_BACKEND@" STREQUAL "Accelerate")
  include(CMakeFindDependencyMacro)
  find_dependency(BLAS)
  find_dependency(LAPACK)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/phastTargets.cmake")
